<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5FB"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tarjeta Contenedora Blanca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="36dp">

        <!-- Ícono Superior de Seguridad -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_container"
            android:contentDescription="Icono de seguridad"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_camera"
            tools:ignore="HardcodedText,ImageViewTint" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Citizen Security"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- ProgressBar con color morado acorde al diseño -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminateTint="#7C3AED" />

        <!-- Texto indicativo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cargando..."
            android:textColor="#8B5CF6"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>