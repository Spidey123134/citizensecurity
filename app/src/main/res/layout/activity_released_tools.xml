<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D231E">
<ScrollView
    android:id="@+id/tools_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D231E">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_brand"
            android:textSize="16sp"
            android:textColor="#2ECC71" />
        <TextView
            android:id="@+id/home_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityHeading="true"
            android:text="@string/home_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_intro"
            android:textSize="16sp"
            android:textColor="#E2E8F0" />
        <TextView
            android:id="@+id/home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="#163832"
            android:accessibilityLiveRegion="polite"
            android:text="@string/home_checking"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/home_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#007F78"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="@string/home_retry"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/home_report_heading"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_report_description"
            android:textSize="16sp"
            android:textColor="#E2E8F0" />
        <Button
            android:id="@+id/tools_preview_interface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#007F78"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="@string/home_new_report" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/home_list_heading"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_list_description"
            android:textSize="16sp"
            android:textColor="#E2E8F0" />
        <Button
            android:id="@+id/tools_reports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#007F78"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="@string/home_list_button" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/home_map_heading"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_map_description"
            android:textSize="16sp"
            android:textColor="#E2E8F0" />
        <Button
            android:id="@+id/tools_reports_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#007F78"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="@string/home_map_button" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_local_notice"
            android:textSize="14sp"
            android:textColor="#E2E8F0" />
        <Button
            android:id="@+id/tools_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#234D43"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:text="@string/home_back" />
    </LinearLayout>
</ScrollView>
</FrameLayout>
