<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tools_container"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tools_title" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/tools_explanation" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:labelFor="@id/tools_type" android:text="@string/tools_type_label" />
        <Spinner android:id="@+id/tools_type" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/tools_priority" android:text="@string/tools_priority_label" />
        <Spinner android:id="@+id/tools_priority" android:layout_width="match_parent" android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/tools_description" android:text="@string/tools_description_label" />
        <EditText android:id="@+id/tools_description" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="64dp" android:inputType="textMultiLine" android:importantForAutofill="no"
            android:text="@string/tools_example_description" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/tools_date" android:text="@string/tools_date_label" />
        <!-- El formato ISO-8601 UTC requiere letras T/Z; el teclado de fecha no permite escribirlo. -->
        <EditText android:id="@+id/tools_date" android:layout_width="match_parent" android:layout_height="48dp"
            android:inputType="textNoSuggestions" android:importantForAutofill="no" tools:ignore="TextFields" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/tools_reference" android:text="@string/tools_reference_label" />
        <EditText android:id="@+id/tools_reference" android:layout_width="match_parent" android:layout_height="48dp"
            android:inputType="textCapSentences" android:importantForAutofill="no" android:text="@string/tools_example_reference" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/tools_latitude" android:text="@string/tools_latitude_label" />
        <EditText android:id="@+id/tools_latitude" android:layout_width="match_parent" android:layout_height="48dp"
            android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/tools_longitude" android:text="@string/tools_longitude_label" />
        <EditText android:id="@+id/tools_longitude" android:layout_width="match_parent" android:layout_height="48dp"
            android:inputType="numberDecimal|numberSigned" android:importantForAutofill="no" />
        <Button android:id="@+id/tools_receive" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tools_receive" />
        <Button android:id="@+id/tools_validate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tools_validate" />
        <Button android:id="@+id/tools_locations" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tools_locations" />
        <TextView android:id="@+id/tools_result" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/tools_ready" android:textIsSelectable="true"
            android:freezesText="true" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/tools_back" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/tools_back" />
    </LinearLayout>
</ScrollView>
